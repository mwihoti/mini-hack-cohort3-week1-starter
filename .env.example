# Copy to .env and fill in real values. Never commit .env.

# LLM provider — the agent runs on OpenRouter (deepseek/deepseek-v4-flash)
OPENROUTER_API_KEY="sk-or-v1-....."

# Web search tool — free key from app.tavily.com
TAVILY_API_KEY="tvly-....."

